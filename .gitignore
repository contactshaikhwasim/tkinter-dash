# IPython
  .ipython/

# pyenv
#   For a library or package, you might want to commit it. 
#   For an app, it can be useful to include.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you're ignoring it, uncomment the next line:
#Pipfile.lock

# poetry
#   Poetry auto-generates poetry.lock. Usually, you should commit this file.
#   But if you decide to ignore it, uncomment the next line:
#poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
.pdm-plugins/

# venv / Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
